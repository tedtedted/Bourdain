# Copy to .env and fill in. .env is gitignored.
POSTGRES_USER=bourdain
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bourdain

# Optional Socrata app token (avoids throttling): https://dev.socrata.com/docs/app-tokens
SOCRATA_APP_TOKEN=

# Where the HTTP port binds on the host. Default 127.0.0.1; set to the host's
# Tailscale IP to expose it on the tailnet.
BOURDAIN_BIND=127.0.0.1
BOURDAIN_PORT=8080

# Image tag to run: 'edge' (latest main) or an immutable 'sha-<commit>' pin.
BOURDAIN_VERSION=edge
